<?xml version="1.0"?>

<robot name="robotic_arm_4dof">

  <!-- ================= MATERIALS ================= -->

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.1 0.8 1"/>
  </material>

  <material name="green">
    <color rgba="0.1 0.8 0.1 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>


  <!-- ================= BASE ================= -->

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="grey"/>
    </visual>
  </link>


  <!-- ================= LINK 1 ================= -->

  <link name="link1">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.06"/>
      </geometry>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>

    <origin xyz="0 0 0.1" rpy="0 0 0"/>

    <!-- Base rotation -->
    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="50"
      velocity="1.0"/>
  </joint>


  <!-- ================= LINK 2 ================= -->

  <link name="link2">
    <visual>
      <geometry>
        <cylinder length="0.45" radius="0.05"/>
      </geometry>

      <!-- Rotate cylinder to align along X-axis -->
      <origin xyz="0.225 0 0" rpy="0 1.5708 0"/>

      <material name="green"/>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="0 0 0.5" rpy="0 0 0"/>

    <!-- Shoulder pitch -->
    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="50"
      velocity="1.0"/>
  </joint>


  <!-- ================= LINK 3 ================= -->

  <link name="link3">
    <visual>
      <geometry>
        <cylinder length="0.4" radius="0.045"/>
      </geometry>

      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>

      <material name="red"/>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>

    <origin xyz="0.45 0 0" rpy="0 0 0"/>

    <!-- Elbow -->
    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="50"
      velocity="1.0"/>
  </joint>


  <!-- ================= GRIPPER ================= -->

  <link name="gripper_link">
    <visual>
      <geometry>
        <box size="0.15 0.08 0.08"/>
      </geometry>

      <origin xyz="0.075 0 0" rpy="0 0 0"/>

      <material name="black"/>
    </visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="gripper_link"/>

    <origin xyz="0.4 0 0" rpy="0 0 0"/>

    <!-- Wrist roll -->
    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="20"
      velocity="1.0"/>
  </joint>

</robot>